# -----------------------------------------------------------------------------
# Yamtrack configuration template.
# Copy to `.env`, fill in real values, and DO NOT commit `.env`.
#   cp .env.example .env
#
# Every value here is optional with a sensible default, EXCEPT you should set a
# strong SECRET in production. Most settings can also be supplied as
# *_FILE secret-mount paths (e.g. SECRET_FILE, TMDB_API_FILE) instead of env.
# -----------------------------------------------------------------------------

# REQUIRED in production: Django secret key. Generate with: openssl rand -base64 48
SECRET=

# --- Database ---------------------------------------------------------------
# If a DATABASE_URL is set it is used; otherwise DB_* vars; otherwise SQLite.
# URL-encode special chars in the password (e.g. `@` -> `%40`).
DATABASE_URL=
# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_PORT=

# --- Cache / Celery broker (Redis) ------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Metadata providers ------------------------------------------------------
# Register at each provider to obtain keys. Yamtrack's TMDB integration uses the
# v3 API key (api_key); the v4 read-access token is informational only.
TMDB_API=
TVDB_API=
MAL_API=
HARDCOVER_API=          # optional; must start with "Bearer " if set
COMICVINE_API=
IGDB_ID=
IGDB_SECRET=
BGG_API_TOKEN=
STEAM_API_KEY=
TRAKT_API=
TRAKT_API_SECRET=
ANILIST_ID=
ANILIST_SECRET=
SIMKL_ID=
SIMKL_SECRET=

# --- Auth -------------------------------------------------------------------
# Allow new-user self-registration. Keep false once accounts are established.
REGISTRATION=false
# OPEN registration of new social accounts via GET (default false for CSRF safety).
SOCIALACCOUNT_LOGIN_ON_GET=false

# --- Transport security (reverse proxy) -------------------------------------
# Set true once HTTPS is in front and X-Forwarded-Proto is passed.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Set to your public host(s) and origin when behind a proxy:
# ALLOWED_HOSTS=yamtrack.example.com
# CSRF=https://yamtrack.example.com
# URLS=https://yamtrack.example.com
# BASE_URL=/some/path

# --- Misc -------------------------------------------------------------------
TZ=UTC
ADMIN_ENABLED=false
DEBUG=false
